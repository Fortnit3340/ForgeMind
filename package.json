{
  "name": "forgemind-ai",
  "version": "0.6.0",
  "description": "ForgeMind AI - desktop AI workstation for coding, 3D assets, Roblox Studio and Blender",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.forgemind.ai",
    "productName": "ForgeMind AI",
    "files": [
      "src/**/*",
      "bridge/**/*",
      "cloud/**/*",
      "docs/**/*",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}